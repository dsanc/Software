# ============================================================
# CONFIGURACIÓN DE LOGO Y BRANDING - EJEMPLO
# ============================================================

# Logo principal del sidebar
SITE_LOGO_URL=images/logo-sidebar.svg

# Configuración específica del logo del sidebar
LOGO_SIDEBAR_STANDARD=images/logo-sidebar.svg
LOGO_SIDEBAR_HIDPI=images/logo-sidebar-@2x.svg
LOGO_SIDEBAR_FALLBACK=fas fa-cube
LOGO_ALT_TEXT=Mi Empresa

# Logos para navbar (opcional)
LOGO_NAVBAR_STANDARD=images/logo-navbar.svg
LOGO_NAVBAR_HIDPI=images/logo-navbar-@2x.svg

# Favicons
FAVICON_ICO=favicon.ico
FAVICON_PNG=favicon.png

# Información del sitio
SITE_NAME=Mi Aplicación
