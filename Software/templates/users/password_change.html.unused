{% extends 'base_with_sidebar.html' %}
{% load static %}

{% block title %}Cambiar Contraseña - {{ block.super }}{% endblock %}
{% block page_title %}Cambiar Contraseña{% endblock %}

{% block extra_css %}
<style>
.password-container {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
}

.password-card {
    background: white;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 2rem;
    border: 1px solid #e3e6f0;
}

.password-header {
    text-align: center;
    margin-bottom: 2rem;
}

.password-header h2 {
    color: #5a5c69;
    font-weight: 300;
    margin-bottom: 0.5rem;
}

.password-header p {
    color: #858796;
    font-size: 0.9rem;
}

.form-group {
    margin-bottom: 1.5rem;
}

.form-group label {
    font-weight: 600;
    color: #5a5c69;
    margin-bottom: 0.5rem;
    display: block;
}

.form-control {
    border: 1px solid #d1d3e2;
    border-radius: 0.35rem;
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    transition: all 0.2s;
}

.form-control:focus {
    border-color: #4e73df;
    box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
}

.btn-primary {
    background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
    border: none;
    border-radius: 0.35rem;
    padding: 0.75rem 2rem;
    font-weight: 600;
    transition: all 0.2s;
    width: 100%;
}

.btn-primary:hover {
    background: linear-gradient(180deg, #224abe 10%, #1c3a96 100%);
    transform: translateY(-1px);
}

.btn-secondary {
    background: #858796;
    border: none;
    border-radius: 0.35rem;
    padding: 0.75rem 2rem;
    color: white;
    text-decoration: none;
    display: inline-block;
    font-weight: 600;
    transition: all 0.2s;
}

.btn-secondary:hover {
    background: #6c757d;
    color: white;
    text-decoration: none;
    transform: translateY(-1px);
}

.password-strength {
    margin-top: 0.5rem;
}

.strength-bar {
    height: 6px;
    background: #e3e6f0;
    border-radius: 3px;
    overflow: hidden;
    margin-bottom: 0.5rem;
}

.strength-fill {
    height: 100%;
    transition: all 0.3s ease;
    border-radius: 3px;
}

.strength-very-weak { background: #e74a3b; width: 20%; }
.strength-weak { background: #f39c12; width: 40%; }
.strength-medium { background: #f1c40f; width: 60%; }
.strength-strong { background: #27ae60; width: 80%; }
.strength-very-strong { background: #2ecc71; width: 100%; }

.strength-text {
    font-size: 0.8rem;
    font-weight: 600;
}

.strength-criteria {
    font-size: 0.8rem;
    margin-top: 0.5rem;
}

.criteria-item {
    display: flex;
    align-items: center;
    margin-bottom: 0.2rem;
}

.criteria-item i {
    margin-right: 0.5rem;
    width: 16px;
}

.criteria-valid {
    color: #27ae60;
}

.criteria-invalid {
    color: #e74a3b;
}

.help-text {
    font-size: 0.8rem;
    color: #858796;
    margin-top: 0.25rem;
}

.errorlist {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0 0;
}

.errorlist li {
    background: #f8d7da;
    color: #721c24;
    padding: 0.5rem;
    border-radius: 0.35rem;
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
    border: 1px solid #f5c6cb;
}

.action-buttons {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
}

.action-buttons .btn {
    flex: 1;
}

/* Estilos para botones de mostrar/ocultar contraseña */
.input-group .btn-outline-secondary {
    border-color: #d1d3e2;
    color: #6c757d;
    border-radius: 0 0.35rem 0.35rem 0;
}

.input-group .btn-outline-secondary:hover {
    background-color: #f8f9fc;
    border-color: #4e73df;
    color: #4e73df;
}

.input-group .btn-outline-secondary:focus {
    box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.25);
}

.input-group .form-control {
    border-right: none;
    border-radius: 0.35rem 0 0 0.35rem;
}

.input-group .form-control:focus {
    border-right: none;
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.075);
}

.input-group .form-control:focus + .btn-outline-secondary {
    border-color: #4e73df;
}
</style>
{% endblock %}

{% block content %}
<div class="password-container">
    <div class="password-card">
        <div class="password-header">
            <h2>Cambiar Contraseña</h2>
            <p>Actualiza tu contraseña para mantener tu cuenta segura</p>
            
            <!-- Alertas de seguridad -->
            <div class="alert alert-warning" role="alert">
                <i class="fas fa-shield-alt me-2"></i>
                <strong>Seguridad importante:</strong> 
                <ul class="mb-0 mt-2" style="font-size: 0.85rem;">
                    <li>Usa una contraseña única que no hayas usado en otros sitios</li>
                    <li>Incluye al menos 12 caracteres para mayor seguridad</li>
                    <li>Combina letras mayúsculas, minúsculas, números y símbolos</li>
                    <li>Evita información personal como nombres o fechas</li>
                </ul>
            </div>
            
            <!-- Verificación de sesión activa -->
            <div class="alert alert-info" role="alert">
                <i class="fas fa-info-circle me-2"></i>
                <strong>Verificación de identidad:</strong> Por tu seguridad, confirma tu contraseña actual antes de cambiarla.
            </div>
        </div>

        <form method="post" id="password-change-form">
            {% csrf_token %}
            
            <div class="form-group">
                <label for="{{ form.old_password.id_for_label }}">{{ form.old_password.label }}</label>
                <div class="input-group">
                    {{ form.old_password }}
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('{{ form.old_password.id_for_label }}')">
                        <i class="fas fa-eye" id="{{ form.old_password.id_for_label }}-toggle-icon"></i>
                    </button>
                </div>
                {% if form.old_password.errors %}
                    <ul class="errorlist">
                        {% for error in form.old_password.errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="{{ form.new_password1.id_for_label }}">{{ form.new_password1.label }}</label>
                <div class="input-group">
                    {{ form.new_password1 }}
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('{{ form.new_password1.id_for_label }}')">
                        <i class="fas fa-eye" id="{{ form.new_password1.id_for_label }}-toggle-icon"></i>
                    </button>
                </div>
                {% if form.new_password1.help_text %}
                    <div class="help-text">{{ form.new_password1.help_text }}</div>
                {% endif %}
                
                <!-- Indicador de fuerza de contraseña -->
                <div class="password-strength" id="password-strength" style="display: none;">
                    <div class="strength-bar">
                        <div class="strength-fill" id="strength-fill"></div>
                    </div>
                    <div class="strength-text" id="strength-text"></div>
                    <div class="strength-criteria" id="strength-criteria"></div>
                </div>
                
                {% if form.new_password1.errors %}
                    <ul class="errorlist">
                        {% for error in form.new_password1.errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="{{ form.new_password2.id_for_label }}">{{ form.new_password2.label }}</label>
                <div class="input-group">
                    {{ form.new_password2 }}
                    <button class="btn btn-outline-secondary" type="button" onclick="togglePasswordVisibility('{{ form.new_password2.id_for_label }}')">
                        <i class="fas fa-eye" id="{{ form.new_password2.id_for_label }}-toggle-icon"></i>
                    </button>
                </div>
                {% if form.new_password2.errors %}
                    <ul class="errorlist">
                        {% for error in form.new_password2.errors %}
                            <li>{{ error }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </div>

            <div class="action-buttons">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Cambiar Contraseña
                </button>
                <a href="{% url 'users:profile' %}" class="btn btn-secondary">
                    <i class="fas fa-times me-2"></i>Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const passwordInput = document.getElementById('id_new_password1');
    const strengthContainer = document.getElementById('password-strength');
    const strengthFill = document.getElementById('strength-fill');
    const strengthText = document.getElementById('strength-text');
    const strengthCriteria = document.getElementById('strength-criteria');

    function updatePasswordStrength() {
        const password = passwordInput.value;
        
        if (password.length === 0) {
            strengthContainer.style.display = 'none';
            return;
        }
        
        strengthContainer.style.display = 'block';
        
        // Enviar solicitud AJAX para verificar fuerza
        fetch('{% url "users:password_strength_check" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
            },
            body: JSON.stringify({password: password})
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const strength = data.strength;
                
                // Actualizar barra de fuerza
                strengthFill.className = 'strength-fill strength-' + strength.strength.toLowerCase().replace(' ', '-');
                strengthText.textContent = 'Fuerza: ' + strength.strength + ' (' + strength.score + '/100)';
                strengthText.className = 'strength-text ' + (strength.score >= 75 ? 'criteria-valid' : 'criteria-invalid');
                
                // Actualizar criterios
                const criteria = strength.criteria;
                let criteriaHtml = '';
                
                const criteriaLabels = {
                    'length': 'Al menos 8 caracteres',
                    'uppercase': 'Letra mayúscula',
                    'lowercase': 'Letra minúscula',
                    'numbers': 'Número',
                    'special': 'Carácter especial',
                    'no_common': 'No es una contraseña común'
                };
                
                for (const [key, value] of Object.entries(criteria)) {
                    const iconClass = value ? 'fas fa-check criteria-valid' : 'fas fa-times criteria-invalid';
                    criteriaHtml += `
                        <div class="criteria-item">
                            <i class="${iconClass}"></i>
                            ${criteriaLabels[key]}
                        </div>
                    `;
                }
                
                strengthCriteria.innerHTML = criteriaHtml;
            }
        })
        .catch(error => {
            console.error('Error:', error);
        });
    }

    // Variables de seguridad adicionales
    let passwordStrengthScore = 0;
    let failedAttempts = 0;
    const maxAttempts = 5;
    const submitBtn = document.querySelector('button[type="submit"]');
    const confirmPasswordInput = document.getElementById('id_new_password2');
    const oldPasswordInput = document.getElementById('id_old_password');
    const form = document.getElementById('password-change-form');

    // Función mejorada para verificar seguridad
    function enhancedSecurityCheck(password) {
        // Verificaciones de seguridad locales
        const securityChecks = {
            minLength: password.length >= 12, // Recomendado 12+ caracteres
            hasUpper: /[A-Z]/.test(password),
            hasLower: /[a-z]/.test(password),
            hasNumber: /\d/.test(password),
            hasSpecial: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/.test(password),
            noSpaces: !/\s/.test(password),
            notSimple: !isSimplePattern(password),
            notPersonal: !containsUserInfo(password)
        };

        return securityChecks;
    }

    function isSimplePattern(password) {
        const simplePatterns = [
            /123456/i, /abcdef/i, /qwerty/i, /password/i, /admin/i,
            /letmein/i, /welcome/i, /(\w)\1{3,}/i // Repeticiones
        ];
        return simplePatterns.some(pattern => pattern.test(password));
    }

    function containsUserInfo(password) {
        const userInfo = ['{{ user.email|lower }}', '{{ user.first_name|lower }}', '{{ user.last_name|lower }}'];
        const passwordLower = password.toLowerCase();
        return userInfo.some(info => info && passwordLower.includes(info));
    }

    // Verificación de contraseña actual con rate limiting
    function verifyCurrentPassword(currentPassword) {
        if (failedAttempts >= maxAttempts) {
            showSecurityAlert('Demasiados intentos fallidos. Espera antes de continuar.');
            return;
        }

        fetch('{% url "users:verify_current_password" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
            },
            body: JSON.stringify({current_password: currentPassword})
        })
        .then(response => response.json())
        .then(data => {
            if (data.valid) {
                oldPasswordInput.classList.add('is-valid');
                oldPasswordInput.classList.remove('is-invalid');
            } else {
                failedAttempts++;
                oldPasswordInput.classList.add('is-invalid');
                oldPasswordInput.classList.remove('is-valid');
                
                if (failedAttempts >= maxAttempts) {
                    showSecurityAlert('Cuenta temporalmente bloqueada por seguridad.');
                    submitBtn.disabled = true;
                }
            }
        })
        .catch(error => console.error('Error:', error));
    }

    // Validación de coincidencia de contraseñas
    function validatePasswordMatch() {
        const password = passwordInput.value;
        const confirmPassword = confirmPasswordInput.value;
        
        if (confirmPassword && password !== confirmPassword) {
            confirmPasswordInput.classList.add('is-invalid');
            confirmPasswordInput.classList.remove('is-valid');
            return false;
        } else if (confirmPassword && password === confirmPassword) {
            confirmPasswordInput.classList.add('is-valid');
            confirmPasswordInput.classList.remove('is-invalid');
            return true;
        }
        return false;
    }

    function showSecurityAlert(message) {
        const alert = document.createElement('div');
        alert.className = 'alert alert-danger alert-dismissible fade show mt-3';
        alert.innerHTML = `
            <i class="fas fa-exclamation-triangle me-2"></i>
            <strong>Alerta de seguridad:</strong> ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        document.querySelector('.password-card').insertBefore(alert, form);
    }

    // Función mejorada de actualización de fuerza
    function updatePasswordStrengthEnhanced(password) {
        if (!password) {
            strengthContainer.style.display = 'none';
            return;
        }

        strengthContainer.style.display = 'block';
        
        // Verificaciones locales inmediatas
        const securityChecks = enhancedSecurityCheck(password);
        updateSecurityCriteria(securityChecks);

        // Verificación en servidor
        fetch('{% url "users:password_strength_check" %}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRFToken': document.querySelector('[name=csrfmiddlewaretoken]').value
            },
            body: JSON.stringify({password: password})
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                passwordStrengthScore = data.strength.score;
                updateStrengthDisplay(data.strength);
                updateSubmitButtonState();
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showSecurityAlert('Error al verificar la seguridad de la contraseña');
        });
    }

    function updateSecurityCriteria(checks) {
        const criteriaLabels = {
            'minLength': 'Al menos 12 caracteres (recomendado)',
            'hasUpper': 'Letra mayúscula (A-Z)',
            'hasLower': 'Letra minúscula (a-z)',
            'hasNumber': 'Al menos un número (0-9)',
            'hasSpecial': 'Símbolo especial (!@#$%^&*)',
            'noSpaces': 'Sin espacios en blanco',
            'notSimple': 'No es un patrón simple',
            'notPersonal': 'No contiene información personal'
        };
        
        let criteriaHtml = '';
        for (const [key, value] of Object.entries(checks)) {
            const iconClass = value ? 'fas fa-check criteria-valid' : 'fas fa-times criteria-invalid';
            const importance = ['minLength', 'notSimple', 'notPersonal'].includes(key) ? ' fw-bold' : '';
            
            criteriaHtml += `
                <div class="criteria-item${importance}">
                    <i class="${iconClass}"></i>
                    ${criteriaLabels[key]}
                </div>
            `;
        }
        strengthCriteria.innerHTML = criteriaHtml;
    }

    function updateStrengthDisplay(strength) {
        strengthFill.className = 'strength-fill strength-' + strength.strength.toLowerCase().replace(' ', '-');
        strengthText.textContent = 'Fuerza: ' + strength.strength + ' (' + strength.score + '/100)';
        
        if (strength.score >= 75) {
            strengthText.className = 'strength-text criteria-valid';
        } else if (strength.score >= 50) {
            strengthText.className = 'strength-text text-warning';
        } else {
            strengthText.className = 'strength-text criteria-invalid';
        }
    }

    function updateSubmitButtonState() {
        const isPasswordStrong = passwordStrengthScore >= 60;
        const isPasswordMatched = validatePasswordMatch();
        const isCurrentPasswordValid = oldPasswordInput.classList.contains('is-valid');
        const notBlocked = failedAttempts < maxAttempts;

        const canSubmit = isPasswordStrong && isPasswordMatched && isCurrentPasswordValid && notBlocked;
        
        submitBtn.disabled = !canSubmit;
        
        if (!notBlocked) {
            submitBtn.textContent = 'Bloqueado por seguridad';
            submitBtn.className = 'btn btn-danger';
        } else if (!isCurrentPasswordValid) {
            submitBtn.textContent = 'Verifica contraseña actual';
            submitBtn.className = 'btn btn-secondary';
        } else if (!isPasswordStrong) {
            submitBtn.textContent = 'Contraseña muy débil';
            submitBtn.className = 'btn btn-warning';
        } else if (!isPasswordMatched) {
            submitBtn.textContent = 'Las contraseñas no coinciden';
            submitBtn.className = 'btn btn-secondary';
        } else {
            submitBtn.innerHTML = '<i class="fas fa-save me-2"></i>Cambiar Contraseña';
            submitBtn.className = 'btn btn-primary';
        }
    }

    // Rate limiting para envío de formulario
    let lastSubmitTime = 0;
    form.addEventListener('submit', function(e) {
        const now = Date.now();
        if (now - lastSubmitTime < 3000) {
            e.preventDefault();
            showSecurityAlert('Espera 3 segundos antes de intentar nuevamente.');
            return false;
        }
        lastSubmitTime = now;
    });

    // Event listeners mejorados
    passwordInput.addEventListener('input', function() {
        updatePasswordStrengthEnhanced(this.value);
        validatePasswordMatch();
        updateSubmitButtonState();
    });

    if (confirmPasswordInput) {
        confirmPasswordInput.addEventListener('input', function() {
            validatePasswordMatch();
            updateSubmitButtonState();
        });
    }

    if (oldPasswordInput) {
        oldPasswordInput.addEventListener('blur', function() {
            if (this.value) {
                verifyCurrentPassword(this.value);
            }
        });
    }

    // Inicialización
    updateSubmitButtonState();
    
    // Agregar evento de entrada para actualización en tiempo real
    passwordInput.addEventListener('input', updatePasswordStrength);
    
    // Verificar fuerza inicial si hay valor
    if (passwordInput.value) {
        updatePasswordStrength();
    }
});

// Función para mostrar/ocultar contraseñas
function togglePasswordVisibility(fieldId) {
    const passwordField = document.getElementById(fieldId);
    const toggleIcon = document.getElementById(fieldId + '-toggle-icon');
    
    if (passwordField && toggleIcon) {
        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            toggleIcon.className = 'fas fa-eye-slash';
        } else {
            passwordField.type = 'password';
            toggleIcon.className = 'fas fa-eye';
        }
    }
}
</script>
{% endblock %}