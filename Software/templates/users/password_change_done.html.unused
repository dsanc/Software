{% extends 'base.html' %}
{% load static %}

{% block title %}Contraseña Cambiada{% endblock %}

{% block extra_css %}
<style>
.success-container {
    max-width: 500px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
}

.success-card {
    background: white;
    border-radius: 10px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    padding: 3rem 2rem;
    border: 1px solid #e3e6f0;
}

.success-icon {
    font-size: 4rem;
    color: #1cc88a;
    margin-bottom: 1.5rem;
    display: block;
}

.success-title {
    color: #5a5c69;
    font-size: 1.5rem;
    font-weight: 300;
    margin-bottom: 1rem;
}

.success-message {
    color: #858796;
    margin-bottom: 2rem;
    line-height: 1.6;
}

.security-notice {
    background: #d1ecf1;
    border: 1px solid #bee5eb;
    border-radius: 0.35rem;
    padding: 1rem;
    margin-bottom: 2rem;
    color: #0c5460;
    font-size: 0.9rem;
}

.security-notice i {
    color: #17a2b8;
    margin-right: 0.5rem;
}

.action-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
}

.btn {
    padding: 0.75rem 2rem;
    border-radius: 0.35rem;
    font-weight: 600;
    text-decoration: none;
    display: inline-block;
    transition: all 0.2s;
}

.btn-primary {
    background: linear-gradient(180deg, #4e73df 10%, #224abe 100%);
    border: none;
    color: white;
}

.btn-primary:hover {
    background: linear-gradient(180deg, #224abe 10%, #1c3a96 100%);
    color: white;
    text-decoration: none;
    transform: translateY(-1px);
}

.btn-secondary {
    background: #858796;
    border: none;
    color: white;
}

.btn-secondary:hover {
    background: #6c757d;
    color: white;
    text-decoration: none;
    transform: translateY(-1px);
}

.security-tips {
    text-align: left;
    margin-top: 2rem;
}

.security-tips h4 {
    color: #5a5c69;
    font-size: 1rem;
    margin-bottom: 1rem;
}

.security-tips ul {
    list-style: none;
    padding: 0;
}

.security-tips li {
    padding: 0.5rem 0;
    border-bottom: 1px solid #e3e6f0;
    color: #858796;
    font-size: 0.9rem;
}

.security-tips li:last-child {
    border-bottom: none;
}

.security-tips li i {
    color: #1cc88a;
    margin-right: 0.5rem;
    width: 16px;
}
</style>
{% endblock %}

{% block content %}
<div class="success-container">
    <div class="success-card">
        <i class="fas fa-check-circle success-icon"></i>
        
        <h2 class="success-title">¡Contraseña Cambiada Exitosamente!</h2>
        
        <p class="success-message">
            Tu contraseña ha sido actualizada correctamente. Tu cuenta ahora está más segura.
        </p>

        <div class="security-notice">
            <i class="fas fa-shield-alt"></i>
            <strong>Medida de Seguridad:</strong> Por tu seguridad, hemos cerrado todas las sesiones 
            activas en otros dispositivos. Necesitarás iniciar sesión nuevamente en esos dispositivos.
        </div>

        <div class="action-buttons">
            <a href="{% url 'users:profile' %}" class="btn btn-primary">
                <i class="fas fa-user mr-2"></i>Ver Mi Perfil
            </a>
            <a href="{% url 'dashboard:dashboard' %}" class="btn btn-secondary">
                <i class="fas fa-home mr-2"></i>Ir al Dashboard
            </a>
        </div>

        <div class="security-tips">
            <h4><i class="fas fa-lightbulb mr-2"></i>Consejos de Seguridad</h4>
            <ul>
                <li>
                    <i class="fas fa-check"></i>
                    Nunca compartas tu contraseña con nadie
                </li>
                <li>
                    <i class="fas fa-check"></i>
                    Usa contraseñas únicas para cada servicio
                </li>
                <li>
                    <i class="fas fa-check"></i>
                    Considera usar un gestor de contraseñas
                </li>
                <li>
                    <i class="fas fa-check"></i>
                    Cambia tu contraseña periódicamente
                </li>
                <li>
                    <i class="fas fa-check"></i>
                    Cierra sesión en dispositivos públicos
                </li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}