# ============================================================
# Variables de entorno para PythonAnywhere
# Copiar este archivo como .env en el servidor y completar valores
# ============================================================

# Django
DEBUG=False
SECRET_KEY=cambia-esto-por-una-clave-secreta-segura-de-50-caracteres

# Dominio: tuusuario.pythonanywhere.com  (sin http://)
# Si tienes dominio propio agrégalo también separado por coma
ALLOWED_HOSTS=tuusuario.pythonanywhere.com

# CSRF — incluir el protocolo https://
CSRF_TRUSTED_ORIGINS=https://tuusuario.pythonanywhere.com

# Base de datos MySQL (los datos los encuentras en el panel de PythonAnywhere > Databases)
DB_NAME=tuusuario$nombre_base_de_datos
DB_USER=tuusuario
DB_PASSWORD=tu_password_mysql
DB_HOST=tuusuario.mysql.pythonanywhere-services.com
DB_PORT=3306
